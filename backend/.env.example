# 复制为 backend/.env 后按需修改；.env 不入库
# 变量统一使用 NWBD_SKILLS_ 前缀，定义见 app/core/config.py

# 数据库（scripts/init-local-db.sql 创建的本地库）
NWBD_SKILLS_DATABASE_URL=postgresql+psycopg://skills:skills_dev@127.0.0.1:5432/skills

# 令牌签名密钥，本地可随意填写，生产必须替换为随机长字符串
NWBD_SKILLS_JWT_SECRET=dev-secret-change-me

# 技能包存储目录，相对于运行目录（backend/）
NWBD_SKILLS_DATA_DIR=./data

# 初始管理员，首次启动创建，已存在则跳过
NWBD_SKILLS_BOOTSTRAP_ADMIN_USERNAME=admin
NWBD_SKILLS_BOOTSTRAP_ADMIN_PASSWORD=admin12345

# 前后端不同源时填写，逗号分隔；本地用 Vite 代理时留空即可
NWBD_SKILLS_CORS_ORIGINS=

# 钉钉扫码登录，三项齐全才启用，不需要则全部留空
NWBD_SKILLS_DINGTALK_CLIENT_ID=
NWBD_SKILLS_DINGTALK_CLIENT_SECRET=
NWBD_SKILLS_DINGTALK_REDIRECT_URI=
NWBD_SKILLS_DINGTALK_EXTRA_ADMINS=
