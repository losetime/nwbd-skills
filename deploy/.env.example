# 数据库
NWBD_SKILLS_DATABASE_URL=postgresql+psycopg://skills:CHANGE_ME@db:5432/skills

# 令牌签名密钥，部署时必须替换为随机值
NWBD_SKILLS_JWT_SECRET=CHANGE_ME

# 数据目录，容器内固定为 /app/data
NWBD_SKILLS_DATA_DIR=/app/data

# 初始管理员，仅首次启动且账号不存在时创建
NWBD_SKILLS_BOOTSTRAP_ADMIN_USERNAME=admin
NWBD_SKILLS_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# 构建期镜像源，国内服务器建议换成镜像站
APT_MIRROR=deb.debian.org
PYPI_INDEX=https://pypi.org/simple

# 钉钉扫码登录（企业内部应用）
NWBD_SKILLS_DINGTALK_CLIENT_ID=
NWBD_SKILLS_DINGTALK_CLIENT_SECRET=
NWBD_SKILLS_DINGTALK_REDIRECT_URI=https://skills.nwbd.net/login
# 额外管理员：逗号分隔，只按钉钉 userId / unionId 精确匹配（不按显示名）
NWBD_SKILLS_DINGTALK_EXTRA_ADMINS=

# 数据库容器口令
POSTGRES_DB=skills
POSTGRES_USER=skills
POSTGRES_PASSWORD=CHANGE_ME
